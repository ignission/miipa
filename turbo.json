{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".expo/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"deploy": {
			"dependsOn": ["build"],
			"cache": false
		},
		"deploy:api": {
			"dependsOn": ["build"],
			"cache": false
		},
		"deploy:web": {
			"dependsOn": ["build"],
			"cache": false
		}
	}
}
