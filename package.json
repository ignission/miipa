{
	"name": "miipa",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"packages/*",
		"mobile",
		"shared"
	],
	"scripts": {
		"dev": "npx wrangler dev",
		"build": "npx @pandacss/dev codegen && next build",
		"build:worker": "npx @pandacss/dev codegen && rm -rf node_modules/next/dist/compiled/@vercel/og && npx @opennextjs/cloudflare build",
		"start": "next start",
		"deploy:legacy": "npm run build:worker && npx wrangler deploy",
		"deploy:api": "cd packages/api && npx wrangler deploy",
		"deploy:web": "cd mobile && npx expo export --platform web",
		"deploy": "npm run deploy:api && npm run deploy:web",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check --write .",
		"prepare": "npx @pandacss/dev codegen"
	},
	"dependencies": {
		"@ark-ui/react": "^5.30.0",
		"@auth/d1-adapter": "^1.11.1",
		"@opennextjs/cloudflare": "^1.16.5",
		"@park-ui/panda-preset": "^0.43.1",
		"ical.js": "^2.2.1",
		"next": "16.1.6",
		"next-auth": "5.0.0-beta.30",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.12",
		"@cloudflare/workers-types": "^4.20260206.0",
		"@pandacss/dev": "^1.8.1",
		"@types/node": "^24.0.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "^19",
		"tsx": "^4.21.0",
		"typescript": "^5",
		"wrangler": "^4.63.0"
	}
}
