{
	"name": "miipa",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"packages/*",
		"mobile",
		"shared"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:api": "cd packages/api && npx wrangler dev",
		"dev:web": "cd mobile && npx expo start --web",
		"dev:mobile": "cd mobile && npx expo start",
		"build": "turbo build",
		"deploy:api": "cd packages/api && npx wrangler deploy",
		"deploy:web": "cd mobile && npx expo export --platform web",
		"deploy": "npm run deploy:api && npm run deploy:web",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.12",
		"@types/node": "^24.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5"
	}
}
