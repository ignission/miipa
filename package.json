{
	"name": "miipa",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.12.1",
	"scripts": {
		"dev": "turbo dev",
		"dev:api": "cd packages/api && npx wrangler dev",
		"dev:web": "cd mobile && npx expo start --web",
		"dev:mobile": "cd mobile && npx expo start",
		"build": "turbo build",
		"deploy:api": "cd packages/api && npx wrangler deploy --env production",
		"deploy:web": "cd mobile && npx expo export --platform web && npx wrangler pages deploy dist --project-name=miipa --branch=main",
		"deploy": "pnpm run deploy:api && pnpm run deploy:web",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"knip": "knip"
	},
	"pnpm": {
		"overrides": {
			"react": "19.1.0",
			"react-dom": "19.1.0",
			"react-native-svg": "15.15.3",
			"react-test-renderer": "19.2.4"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/workers-types": "^4.20260228.0",
		"@types/node": "^24.0.0",
		"knip": "^5",
		"tsx": "^4.21.0",
		"turbo": "^2.8.10",
		"typescript": "^5"
	}
}
